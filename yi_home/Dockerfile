FROM ghcr.io/home-assistant/base:3.23

ARG BUILD_VERSION=0.1.0
ARG BUILD_ARCH=amd64
ARG GO2RTC_VERSION=1.9.14
ARG GO2RTC_SHA256=32d616af226bd731678ffde328b94cfb94e30339bfefc469cfb76323144615a6

SHELL ["/bin/ash", "-o", "pipefail", "-c"]

RUN apk add --no-cache \
      ca-certificates \
      curl \
      ffmpeg \
      py3-cryptography \
      python3 \
      qemu-aarch64 \
    && curl -fsSL \
      -o /usr/local/bin/go2rtc \
      "https://github.com/AlexxIT/go2rtc/releases/download/v${GO2RTC_VERSION}/go2rtc_linux_amd64" \
    && echo "${GO2RTC_SHA256}  /usr/local/bin/go2rtc" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/go2rtc

# Generated by tools/prepare_ha_app_context.py. The staged tree contains only
# project Python sources plus the already-proven Bionic/native runtime; it must
# never contain the development .env file or camera/account credentials.
COPY rootfs/ /
COPY run.sh /run.sh
RUN chmod 0755 /run.sh \
    && test -f /opt/yi-home/app/yi_addon_service.py \
    && test -x /opt/yi-home/runtime/bionic-root/system/bin/linker64 \
    && test -x /opt/yi-home/runtime/bionic-root/data/local/tmp/yi-online-status/android_pppp_online_probe \
    && test -f /opt/yi-home/runtime/bionic-root/data/local/tmp/yi-online-status/libPPPP_API.so \
    && python3 -m py_compile /opt/yi-home/app/*.py

LABEL \
  io.hass.version="${BUILD_VERSION}" \
  io.hass.type="app" \
  io.hass.arch="${BUILD_ARCH}" \
  org.opencontainers.image.title="Home Assistant App: YI Home" \
  org.opencontainers.image.description="Native YI Home PPPP/TNP camera runtime" \
  org.opencontainers.image.source="https://github.com/Dmxsir/yi-cam-integration"

CMD ["/run.sh"]
